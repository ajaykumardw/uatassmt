model questions {
  id                   Int            @id @default(autoincrement())
  agency_id            Int
  ssc_id               Int
  qp_id                Int
  nos_id               Int?
  language_id          Int
  question_level       question_level @default(E)
  question_type        question_type  @default(theory)
  question             String         @db.Text
  option1              String?        @db.Text
  option2              String?        @db.Text
  option3              String?        @db.Text
  option4              String?        @db.Text
  option5              String?        @db.Text
  answer               Int?           @db.TinyInt
  marks                Int
  question_explanation String?        @db.Text
  status               Int            @default(1) @db.TinyInt
  created_by           Int
  deactive_date        DateTime?
  created_at           DateTime?      @default(now()) @db.DateTime(0)
  updated_at           DateTime?      @default(now()) @db.DateTime(0)

  pc pc[]

  exam_sets_questions exam_sets_questions[]
  exam_set_results     exam_set_results[]    @relation("QuestionToExamSetResults")
  student_question_attempts student_question_attempts[]
}

model exam_set_results {
  id                 Int       @id @default(autoincrement())
  exam_set_id        Int
  student_id         Int
  question_id        Int
  student_answer     Int
  correct_answer     Int
  attempt_time_data  String    @db.Text
  created_by         Int
  updated_by         Int
  created_at         DateTime? @default(now()) @db.DateTime(0)
  updated_at         DateTime? @default(now()) @db.DateTime(0)

  student students @relation(fields: [student_id], references: [id])
  question            questions  @relation("QuestionToExamSetResults", fields: [question_id], references: [id])
}

model student_exam_set_results {
  id Int @id @default(autoincrement())
  language_id Int
  student_id Int
  exam_set_id Int
  total_questions Int
  attempt_questions Int
  total_attempts Int
  exam_total_time DateTime @db.Time()
  exam_spent_time String? @db.VarChar(20)
  correct Int?
  incorrect Int?
  exam_appear_date DateTime
  ip_address String @db.VarChar(60)
  user_agent String @db.Text
  is_active Int @default(1) @db.TinyInt

  student students @relation(fields: [student_id], references: [id])
  exam_set exam_sets @relation(fields: [exam_set_id], references: [id])

  @@unique([student_id, exam_set_id])
}

model student_captured_images {
  id Int @id @default(autoincrement())
  student_id Int
  student_exam_set_result_id Int
  captured_image String @db.Text
  captured_time DateTime
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model questionpapers {
  ques_id        Int                           @id @default(autoincrement())
  question       String                        @db.Text
  option_a       String                        @db.Text
  option_b       String                        @db.Text
  option_c       String                        @db.Text
  option_d       String                        @db.Text
  question_level questionpapers_question_level
  correct_answer questionpapers_correct_answer
  pcid           Int
  postdate       DateTime                      @default(now()) @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sector_skill_councils {
  id           Int       @id @default(autoincrement())
  agency       users     @relation(fields: [agency_id], references: [id])
  agency_id    Int
  ssc_name     String    @db.VarChar(100)
  ssc_code     String?   @db.VarChar(60)
  ssc_username String?   @db.VarChar(100)
  ssc_pwd      String?   @db.VarChar(100)
  ssc_image    String?
  status       Int       @default(1) @db.TinyInt
  created_by   Int?
  deleted_at   DateTime? @db.DateTime(0)
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @default(now()) @updatedAt @db.DateTime(0)

  qualification_packs qualification_packs[]
  nos                 nos[]
  exam_instructions   exam_instructions[]

  @@unique([ssc_username, agency_id], map: "sector_skill_council_name")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model state {
  state_id   Int     @id @default(autoincrement())
  state_name String  @db.VarChar(80)
  country_id Int     @default(1)
  is_active  Boolean @default(true)
  users      users[]
}

model users {
  id            Int          @id @default(autoincrement())
  ssc_id        Int?
  tp_id         Int?
  email         String       @unique(map: "email") @db.VarChar(100)
  user_name     String?      @unique(map: "user_name") @db.VarChar(60)
  password      String?      @db.VarChar(80)
  salt          String?      @db.VarChar(80)
  company_name  String?      @db.VarChar(100)
  user_type     String       @default("U") @db.VarChar(2)
  first_name    String?      @db.VarChar(100)
  last_name     String?      @db.VarChar(100)
  mobile_no     String?       @db.VarChar(15)
  landline_no   String?      @db.VarChar(15)
  gender        users_gender @default(m)
  date_of_birth DateTime?    @db.Date
  country_id    Int?
  state         state?       @relation(fields: [state_id], references: [state_id])
  state_id      Int?
  city          city?        @relation(fields: [city_id], references: [city_id])
  city_id       Int?
  district_id   Int?
  address       String?
  pin_code      String?      @db.VarChar(6)
  time_zone     String?      @db.VarChar(100)
  avatar        String?
  expiry_date   DateTime?    @db.Date
  is_master     Boolean      @default(true)
  master_id     Int
  created_by    Int?
  status        Int          @default(1) @db.TinyInt
  is_deleted    Int          @default(0) @db.TinyInt
  device_id     String?      @db.Text
  deactive_date DateTime?    @db.DateTime(0)
  created_at    DateTime     @default(now()) @db.DateTime(0)
  updated_at    DateTime     @default(now()) @updatedAt @db.DateTime(0)
  role_id Int?
  fcm_token     String?      @db.Text
  role role? @relation(fields: [role_id], references: [id])

  sector_skills sector_skill_councils[]
  user_additional_data users_additional_data?
  trainingPartnerBatches batches[] @relation("training_partner")
  trainingCenterBatches batches[] @relation("training_center")
  assessor_batches batches[] @relation("assessor")
  students students[]
  exam_instructions exam_instructions[]
  log_sessions log_sessions[]
  user_training_resources user_training_resources[]
  center_inspections inspection_media[]
}

model users_additional_data {
  id                        Int     @id @default(autoincrement())
  user                      users   @relation(fields: [user_id], references: [id])
  user_id                   Int     @unique
  employee_id               String?
  job_roles                 Json?
  job_valid_upto            String? @db.Text
  toa_nomination            Int?    @db.TinyInt
  last_qualification        String?
  aadhaar_no                String?
  pan_card_no               String?
  gst_no                    String?
  certificate_8th           String?  @db.Text
  certificate_10th          String?  @db.Text
  certificate_12th          String?  @db.Text
  certificate_DIPLOMA       String?  @db.Text
  certificate_UG            String?  @db.Text
  certificate_PG            String?  @db.Text
  assessor_certificate      String?  @db.Text
  agreement_copy            String?  @db.Text
  aadhaar_card              String?  @db.Text
  resume_cv                 String?  @db.Text
  pan_card                  String?  @db.Text
  contact_person_address    String?  @db.Text
  cancel_check              String?  @db.Text
  bank_name                 String?
  account_no                Int?
  ifsc_code                 String?
  created_at                DateTime @default(now()) @db.DateTime(0)
  updated_at                DateTime @default(now()) @updatedAt @db.DateTime(0)
}

model role {
  id Int @id @default(autoincrement())
  name String
  users users[]
}

model students {
  id             Int                @id @default(autoincrement())
  batch          batches            @relation(fields: [batch_id], references: [id])
  batch_id       Int
  candidate_id   String             @unique @db.VarChar(60)
  user_name      String             @unique @db.VarChar(60)
  password       String             @db.VarChar(80)
  candidate_name String             @db.VarChar(50)
  gender         users_gender?      @default(m)
  category       students_category? @default(Gen)
  date_of_birth  DateTime?          @db.Date
  father_name    String?            @db.VarChar(50)
  mother_name    String?            @db.VarChar(50)
  state          String?            @db.VarChar(50)
  city           String?            @db.VarChar(50)
  address        String?            @db.VarChar(255)
  mobile_no      String?             @db.VarChar(15)
  agency         users              @relation(fields: [agency_id], references: [id])
  agency_id      Int
  created_by     Int
  created_at     DateTime           @default(now()) @db.DateTime(0)
  updated_at     DateTime           @default(now()) @updatedAt @db.DateTime(0)
  image          String?            @db.VarChar(255)
  id_front_image String?            @db.VarChar(255)
  id_back_image  String?            @db.VarChar(255)
  practical_group_id       Int?
  viva_group_id            Int?
  aadhaar_no     String?            @db.Text
  practical_group  student_groups?    @relation("practicalGroup", fields: [practical_group_id], references: [id])
  viva_group       student_groups?    @relation("vivaGroup", fields: [viva_group_id], references: [id])

  student_exam_set_results student_exam_set_results[]
  exam_set_results exam_set_results[]
  student_question_attempts student_question_attempts[]
}

model student_groups {
  id Int @id @default(autoincrement())
  batch_id Int
  group_id String @db.VarChar(60)
  group_type String @db.VarChar(5)
  group_photo String? @db.VarChar(255)
  group_video String? @db.VarChar(255)
  created_by Int
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  practical_students students[] @relation("practicalGroup")
  viva_students students[] @relation("vivaGroup")

}

model student_question_attempts {
  id Int @id @default(autoincrement())
  student_id Int
  question_id Int
  assessor_id Int?
  max_marks Decimal@db.Decimal(10, 2)
  obtained_marks Decimal? @db.Decimal(10, 2)
  attempt_no Int @default(1)
  attempted_at DateTime @default(now()) @db.DateTime(0)
  evaluated_at DateTime? @db.DateTime(0)
  remarks String? @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  student students @relation(fields: [student_id], references: [id])
  question questions @relation(fields: [question_id], references: [id])

  @@unique([student_id, question_id, attempt_no])
}

model exam_instructions {
  id            Int                   @id @default(autoincrement())
  ssc_id        Int
  instruction   String                @db.Text
  agency_id     Int
  created_by    Int
  created_at    DateTime              @default(now()) @db.DateTime(0)
  updated_at    DateTime              @default(now()) @updatedAt @db.DateTime(0)
  status        Int                   @default(1) @db.TinyInt
  ssc           sector_skill_councils @relation(fields: [ssc_id], references: [id])
  agency        users                 @relation(fields: [agency_id], references: [id])
}

model log_sessions {
  id         Int            @id @default(autoincrement())
  user_id    Int
  unique_session_id String? @db.VarChar(120)
  user_type  log_user_type  @default(U)
  auth_image String?        @db.Text
  status     log_status     @default(IN)
  ip_address String?        @db.VarChar(20)
  user_agent String?        @db.VarChar(255)
  login_at   DateTime?      @db.DateTime(0)
  logout_at  DateTime?      @db.DateTime(0)
  user       users          @relation(fields: [user_id], references: [id])
}

model exam_sets {
  id              Int           @id @default(autoincrement())
  agency_id       Int
  ssc_id          Int
  qp_id           Int
  set_name        String
  set_type        exam_set_type @default(T)
  mode            exam_set_mode @default(Manual)
  question_random Int           @default(0) @db.TinyInt
  option_random   Int           @default(0) @db.TinyInt
  total_questions Int
  exam_duration   Int           @default(30)
  instruction     String?
  question_levels Json?
  status          Int           @default(0) @db.TinyInt
  created_by      Int
  created_at      DateTime      @default(now()) @db.DateTime(0)
  updated_at      DateTime      @default(now()) @updatedAt @db.DateTime(0)

  exam_sets_questions exam_sets_questions[]
  batch               batches[] @relation("theory_exam_set")
  practical_batch     batches[] @relation("practical_exam_set")
  viva_batch          batches[] @relation("viva_exam_set")
  qp                  qualification_packs @relation(fields: [qp_id], references: [id])
  student_exam_set_results student_exam_set_results[]
}

model exam_sets_questions {
  id          Int @id @default(autoincrement())
  agency_id   Int
  exam_set_id Int
  question_id Int
  marks       Int
  created_by  Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  exam_sets exam_sets @relation(fields: [exam_set_id], references: [id])
  questions questions @relation(fields: [question_id], references: [id])

  @@unique(name: "exam_set_id_question_id", [exam_set_id, question_id])
}

model training_resources {
  id Int @id @default(autoincrement())
  ssc_id Int
  name String @db.VarChar(255)
  file String? @db.Text
  description String? @db.VarChar(255)
  status Int           @default(1) @db.TinyInt
  created_by Int
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)
  user_training_resources user_training_resources[]
}

model user_training_resources {
  // id                   Int                @id @default(autoincrement())
  user_id              Int
  training_resource_id Int
  is_read              Int                @default(0) @db.TinyInt
  user                 users              @relation(fields: [user_id], references: [id])
  trainingResource     training_resources @relation(fields: [training_resource_id], references: [id])

  @@id([user_id, training_resource_id]) // Ensure unique pairs
  @@unique([user_id, training_resource_id]) // Ensure unique pairs
}

model feedback_forms {
  id          Int      @id @default(autoincrement())
  form_name  String   @db.VarChar(100)
  form_type   Int @db.TinyInt
  created_by  Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  feedback_questions feedback_questions[]
  feedback_responses feedback_responses[]
}

model feedback_questions {
  id                   Int      @id @default(autoincrement())
  feedback_form_id     Int
  question             String   @db.Text
  question_type        Int @db.TinyInt
  option1              String?  @db.VarChar(100)
  option2              String?  @db.VarChar(100)
  option3              String?  @db.VarChar(100)
  option4              String?  @db.VarChar(100)
  created_by           Int
  created_at           DateTime @default(now()) @db.DateTime(0)
  updated_at           DateTime @default(now()) @updatedAt @db.DateTime(0)

  feedback_form       feedback_forms @relation(fields: [feedback_form_id], references: [id])
  feedback_response_answers feedback_response_answers[]
}

model feedback_responses {
  id                   Int      @id @default(autoincrement())
  feedback_form_id     Int
  user_type            Int @db.TinyInt
  user_id              Int
  submitted_at         DateTime @db.DateTime(0)
  created_at           DateTime @default(now()) @db.DateTime(0)
  updated_at           DateTime @default(now()) @updatedAt @db.DateTime(0)

  feedback_form       feedback_forms @relation(fields: [feedback_form_id], references: [id])
  feedback_response_answers feedback_response_answers[]
}

model feedback_response_answers {
  id                   Int      @id @default(autoincrement())
  feedback_response_id Int
  feedback_question_id Int
  answer_value         String   @db.VarChar(100)
  created_by           Int
  created_at           DateTime @default(now()) @db.DateTime(0)
  updated_at           DateTime @default(now()) @updatedAt @db.DateTime(0)

  feedback_response   feedback_responses @relation(fields: [feedback_response_id], references: [id])
  feedback_question   feedback_questions @relation(fields: [feedback_question_id], references: [id])
}

model inspection_media {
  id Int @id @default(autoincrement())
  category_id Int
  batch_id Int
  assessor_id Int
  media_type inspection_media_type
  file_name String @db.VarChar(255)
  uploaded_by Int
  uploaded_at DateTime @default(now()) @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  category categories @relation(fields: [category_id], references: [id])
  batch batches @relation(fields: [batch_id], references: [id])
  assessor users @relation(fields: [assessor_id], references: [id])
}

